@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    @if ((User.IsInRole(Projeto1_IF.Authorization.AppRoles.Medico) || User.IsInRole(Projeto1_IF.Authorization.AppRoles.Nutricionista))
        && !User.IsInRole(Projeto1_IF.Authorization.AppRoles.GerenteGeral)
        && !User.IsInRole(Projeto1_IF.Authorization.AppRoles.GerenteMedico)
        && !User.IsInRole(Projeto1_IF.Authorization.AppRoles.GerenteNutricionista))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="TbProfissionals" asp-action="MyProfile">Meu perfil Profissional</a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Configurações da conta">Minha conta</a>
    </li>
    <li class="nav-item">
        <form  class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button  type="submit" class="nav-link btn btn-link text-dark">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Registar</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
