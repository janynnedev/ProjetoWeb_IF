@model Projeto1_IF.Models.TbProfissional
@{
    var isManager = User.IsInRole(Projeto1_IF.Authorization.AppRoles.GerenteGeral) || User.IsInRole(Projeto1_IF.Authorization.AppRoles.GerenteMedico) || User.IsInRole(Projeto1_IF.Authorization.AppRoles.GerenteNutricionista);
    ViewData["Title"] = isManager ? "Editar profissional" : "Meu Perfil Profissional";
}
<h1>@ViewData["Title"]</h1>
<div class="row"><div class="col-md-6">
    <form asp-action="Edit" asp-route-id="@Model.IdProfissional" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label for="IdEstado" class="form-label">Estado da cidade cadastrada</label>
            <select id="IdEstado" name="IdEstado" asp-items="ViewBag.IdEstado" class="form-select" data-city-select="IdCidade" data-cities-url="@Url.Action("Cities", "Locations")">
                <option value="">Selecione um estado</option>
            </select>
            @Html.ValidationMessage("IdEstado", null, new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            <label asp-for="IdCidade" class="form-label"></label>
            <select asp-for="IdCidade" asp-items="ViewBag.IdCidade" class="form-select" disabled="@(ViewBag.SelectedStateId is not > 0)"><option value="">Selecione uma cidade</option></select>
            <span asp-validation-for="IdCidade" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Cpf" class="form-label"></label>
            @if (isManager)
            {
                <input asp-for="Cpf" class="form-control" />
            }
            else
            {
                <input asp-for="Cpf" class="form-control" readonly />
            }
            <span asp-validation-for="Cpf" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CrmCrn" class="form-label"></label>
            <input asp-for="CrmCrn" class="form-control" />
            <span asp-validation-for="CrmCrn" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Especialidade" class="form-label"></label>
            <input asp-for="Especialidade" class="form-control" />
            <span asp-validation-for="Especialidade" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Logradouro" class="form-label"></label>
            <input asp-for="Logradouro" class="form-control" />
            <span asp-validation-for="Logradouro" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Numero" class="form-label"></label>
            <input asp-for="Numero" class="form-control" />
            <span asp-validation-for="Numero" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Bairro" class="form-label"></label>
            <input asp-for="Bairro" class="form-control" />
            <span asp-validation-for="Bairro" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Cep" class="form-label"></label>
            <input asp-for="Cep" class="form-control" />
            <span asp-validation-for="Cep" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Cidade" class="form-label">Cidade do endereço (texto)</label>
            <input asp-for="Cidade" class="form-control" />
            <span asp-validation-for="Cidade" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Estado" class="form-label">UF do endereço (texto)</label>
            <input asp-for="Estado" class="form-control" />
            <span asp-validation-for="Estado" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Ddd1" class="form-label"></label>
            <input asp-for="Ddd1" class="form-control" />
            <span asp-validation-for="Ddd1" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Ddd2" class="form-label"></label>
            <input asp-for="Ddd2" class="form-control" />
            <span asp-validation-for="Ddd2" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Telefone1" class="form-label"></label>
            <input asp-for="Telefone1" class="form-control" />
            <span asp-validation-for="Telefone1" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Telefone2" class="form-label"></label>
            <input asp-for="Telefone2" class="form-control" />
            <span asp-validation-for="Telefone2" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Salvar</button>
    </form>
</div></div>
<a asp-action="Details" asp-route-id="@Model.IdProfissional">Voltar aos detalhes</a>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/state-cities.js" asp-append-version="true"></script>
}
